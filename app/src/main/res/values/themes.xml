<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Androidtemplate" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorAccent">@color/brand_blue</item>
    </style>

    <style name="Theme.Androidtemplate.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/adhl_logo</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="windowSplashScreenBackground">@color/brand_blue</item>
        <item name="postSplashScreenTheme">@style/Theme.Androidtemplate</item>
    </style>
</resources>